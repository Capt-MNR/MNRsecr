# Server-only LLM configuration. Never put a real key in this file.
AI_PROVIDER=gemini
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=
GEMINI_CONTEXT_CACHE_TTL_SECONDS=3600
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=
COHERE_MODEL=command-r-08-2024
COHERE_API_KEY=

# Phase 2 optimization layers. Keep disabled until their measurements are reviewed.
CTX_BUDGETER_ENABLED=false
LOCAL_ROUTER_ENABLED=false
RESOLVER_SHADOW=true
DETERMINISTIC_PLANS_ENABLED=false
DECISION_CACHE_ENABLED=false
PROVIDER_ROUTING_ENABLED=false
CTX_BUDGET_MAX_CONVERSATION_CHARS=8000
CTX_BUDGET_MAX_TOOL_DEFINITIONS=16
CTX_BUDGET_MAX_TOOL_RESULT_CHARS=2000
PROVIDER_ROUTING_ORDER=gemini,groq,mistral,cohere