modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
AI_ROUTE_ORDER = "direct:groq,direct:gemini,direct:cohere,gateway:openrouter"

[userenv.shared]
AI_PROVIDER = "groq"
AI_FALLBACK_PROVIDER = "gemini"
AI_SECONDARY_FALLBACK_PROVIDER = "cohere"
GEMINI_MODEL = "gemini-3.1-flash-lite"
GOOGLE_OAUTH_CLIENT_ID = "capt.mnr@gmail.com"
MICROSOFT_OAUTH_CLIENT_ID = "capt.mnr@hotmail.com"

[nix]
channel = "stable-25_05"
