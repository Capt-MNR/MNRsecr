{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:phase2": "node --test test/phase2.integration.mjs",
    "test:intent-eval-dataset": "node --test test/intent-evaluation/dataset.test.mjs",
    "test:financial": "../../scripts/node_modules/.bin/tsx --test test/activity-atomicity.test.ts test/financial-graph.test.ts test/relationship-graph.test.ts",
    "test:dialect": "../../scripts/node_modules/.bin/tsx --test test/deterministic-intelligence.test.ts test/arabic-dialect-corpus.test.ts test/phase2-optimization-layers.test.ts",
    "test:learning-signals": "../../scripts/node_modules/.bin/tsx --test test/learning-signals.test.ts",
    "test:learning-review": "../../scripts/node_modules/.bin/tsx --test test/learning-signal-review.test.ts",
    "test:phase4": "../../scripts/node_modules/.bin/tsx --test test/phase4-context.test.ts",
    "test:http-phase3": "../../scripts/node_modules/.bin/tsx --test test/http-phase3.test.ts",
    "test:phase3:records": "node --test test/phase3.records.integration.mjs",
    "test:expense-report": "node --experimental-strip-types --test test/expense-report.test.ts",
    "test:intent-eval": "../../scripts/node_modules/.bin/tsx ./test/intent-evaluation/runner.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
