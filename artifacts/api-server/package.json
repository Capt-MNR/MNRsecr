{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development AGENT_WORK_ENABLED=${AGENT_WORK_ENABLED:-true} AGENT_WORK_ALLOW_DEVELOPMENT_IDENTITY=${AGENT_WORK_ALLOW_DEVELOPMENT_IDENTITY:-true} AGENT_WORK_RUNNER_ENABLED=${AGENT_WORK_RUNNER_ENABLED:-true} && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:phase2": "node --test test/phase2.integration.mjs",
    "test:agent-work": "../../scripts/node_modules/.bin/tsx --test test/agent-work-contract.test.ts test/agent-work-runner.test.ts test/agent-work-recovery.test.ts test/github-monitoring.test.ts test/delegated-action.test.ts test/agent-work-restart.test.ts test/notification-outbox.test.ts",
    "test:trigger-outbox": "../../scripts/node_modules/.bin/tsx --test test/trigger-outbox.test.ts",
    "test:trigger-stress": "../../scripts/node_modules/.bin/tsx --test test/trigger-stress.test.ts",
    "test:intent-eval-dataset": "../../scripts/node_modules/.bin/tsx --test test/intent-evaluation/dataset.test.mjs test/intent-evaluation/runner.test.ts",
    "test:brain-eval": "../../scripts/node_modules/.bin/tsx --test test/brain-evaluation/evaluation.test.ts",
    "test:brain-reasoning-safety": "../../scripts/node_modules/.bin/tsx --test test/brain-evaluation/reasoning-safety.test.ts",
    "run:brain-real-planning": "../../scripts/node_modules/.bin/tsx test/brain-evaluation/real-planning.ts",
    "run:brain-provider-planning": "../../scripts/node_modules/.bin/tsx test/brain-evaluation/provider-planning-baseline.ts",
    "run:brain-eval": "../../scripts/node_modules/.bin/tsx test/brain-evaluation/run.ts",
    "test:financial": "../../scripts/node_modules/.bin/tsx --test test/activity-atomicity.test.ts test/financial-graph.test.ts test/relationship-graph.test.ts",
    "test:approval-reconciliation": "../../scripts/node_modules/.bin/tsx --test test/approval-reconciliation.test.ts",
    "test:auth": "../../scripts/node_modules/.bin/tsx --test test/auth-isolation.test.ts test/auth-abuse.test.ts test/push-token-handoff.test.ts",
    "test:dialect": "../../scripts/node_modules/.bin/tsx --test test/deterministic-intelligence.test.ts test/arabic-dialect-corpus.test.ts test/phase2-optimization-layers.test.ts",
    "test:learning-signals": "../../scripts/node_modules/.bin/tsx --test test/learning-signals.test.ts",
    "test:learning-review": "../../scripts/node_modules/.bin/tsx --test test/learning-signal-review.test.ts",
    "test:context-assembly": "../../scripts/node_modules/.bin/tsx --test test/context-assembly.test.ts",
    "test:phase4": "../../scripts/node_modules/.bin/tsx --test test/phase4-context.test.ts",
    "test:http-phase3": "../../scripts/node_modules/.bin/tsx --test test/http-phase3.test.ts",
    "test:phase3:records": "node --test test/phase3.records.integration.mjs",
    "test:expense-report": "node --experimental-strip-types --test test/expense-report.test.ts",
    "test:input-assets": "../../scripts/node_modules/.bin/tsx --test test/input-assets.test.ts",
    "test:intent-eval": "../../scripts/node_modules/.bin/tsx ./test/intent-evaluation/runner.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
