{
  "expo": {
    "name": "Personal Secretary Mobile",
    "slug": "mnr",
    "owner": "captmnrs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_2.png",
    "scheme": "personal-secretary-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.captmnrs.personalsecretary"
    },
    "android": {
      "package": "com.captmnrs.personalsecretary",
      "permissions": ["POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_2.png",
        "backgroundColor": "#f3f0e9"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3362c583-eacf-4207-9432-43d35c43fa65"
      }
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
